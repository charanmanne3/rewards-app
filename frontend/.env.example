# =============================================================================
# Local development (Simulator uses 127.0.0.1 — not localhost)
# =============================================================================
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Physical device on same Wi‑Fi — use your computer's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8000

# Must match backend ADMIN_API_KEY if using admin screens
EXPO_PUBLIC_ADMIN_API_KEY=dev-admin-change-me

# Optional — live nearby business data
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_PUBLIC_YELP_API_KEY=
EXPO_PUBLIC_FOURSQUARE_API_KEY=
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# =============================================================================
# Production / staging (EAS Build — set in eas.json or Expo dashboard secrets)
# =============================================================================
# EXPO_PUBLIC_APP_ENV=production
# EXPO_PUBLIC_API_URL=https://your-service.onrender.com
# Do NOT ship production ADMIN_API_KEY in consumer app builds
