# Production template — set these in Render / Railway / Fly.io dashboard
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

SECRET_KEY=
ADMIN_API_KEY=

# Your deployed Expo web URL, custom domain, or leave empty and use mobile deep links only
CORS_ORIGINS=https://rewards.example.com

ALLOWED_HOSTS=your-service.onrender.com
PORT=10000
WEB_CONCURRENCY=1

EXPIRATION_JOB_ENABLED=true
OFFER_REFRESH_JOB_ENABLED=true
