# =============================================================================
# Local development — copy to .env (never commit .env)
# =============================================================================
APP_NAME=Rewards Recommendation API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text

# PostgreSQL (local install, Supabase, or Render Postgres)
DATABASE_URL=postgresql://rewards_user:rewards_pass@localhost:5432/rewards_db

# Supabase on Render: use Session pooler URI (NOT db.*.supabase.co:5432 direct)
# Example: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Pool tuning (optional — defaults work for Render/Supabase)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800

# Security — generate: openssl rand -hex 32
SECRET_KEY=dev-only-not-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_API_KEY=dev-admin-change-me

# CORS — Expo Metro / simulator (comma-separated, no spaces after commas optional)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,exp://127.0.0.1:8081

# Jobs & cache
RECOMMENDATION_CACHE_TTL_SECONDS=300
EXPIRATION_JOB_ENABLED=true
EXPIRATION_JOB_INTERVAL_MINUTES=60
OFFER_REFRESH_JOB_ENABLED=true
OFFER_REFRESH_INTERVAL_HOURS=6

# Optional provider keys
OPENAI_API_KEY=
AFFILIATE_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
STRIPE_SECRET_KEY=

# =============================================================================
# Production (Render / Supabase) — set in host dashboard, not in repo
# =============================================================================
# APP_ENV=production
# DEBUG=false
# LOG_FORMAT=json
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/postgres?sslmode=require
# SECRET_KEY=<openssl rand -hex 32>
# ADMIN_API_KEY=<openssl rand -hex 32>
# CORS_ORIGINS=https://your-app.vercel.app,exp://your-expo-host
# ALLOWED_HOSTS=your-api.onrender.com
# PORT=10000
# WEB_CONCURRENCY=1
